# Configuracion local de desarrollo. Este archivo NO se sube a git.
# Actualmente en modo REAL: consulta BigQuery y llama a ValleData de verdad.

# ============================================================
# Seguridad
# ============================================================
# Token secreto que debe presentar quien consume esta API.
API_TOKEN=

# ============================================================
# BigQuery — vistas de la analitica de comentarios que DataGov expone
# ============================================================
# true = datos de ejemplo en memoria; false = consulta BigQuery real.
USAR_DATOS_FALSOS=
GCP_PROJECT_ID=

BIGQUERY_DATASET_COMENTARIOS=
BIGQUERY_VISTA_COMENTARIOS_DETALLE=
BIGQUERY_VISTA_COMENTARIOS_RESUMEN_DATASET=

# Llave de la service account.
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# Flujo 2 — Cliente hacia la API ValleData (comentarios)
# ============================================================
# true = comentarios de ejemplo; false = llama a ValleData real.
USAR_VALLEDATA_FALSO=
VALLEDATA_API_BASE_URL=
VALLEDATA_API_TOKEN=
VALLEDATA_TIMEOUT_SEGUNDOS=
