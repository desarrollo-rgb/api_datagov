# Plantilla de configuracion. Copia este archivo a .env y rellena tus valores.
#   cp .env.example .env
# El .env real NO se sube a git (esta en .gitignore).

# --- Seguridad ---
# Token secreto que debe presentar quien consume la API (cabecera Authorization: Bearer).
# Genera uno largo y aleatorio, por ejemplo con:  openssl rand -hex 32
API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# --- Modo de datos ---
# true  -> la API responde con datos de ejemplo, sin tocar BigQuery (desarrollo).
# false -> la API consulta BigQuery de verdad (cuando ya tengas credenciales y tabla).
USAR_DATOS_FALSOS=true

# --- Identidad y ubicacion en GCP ---
GCP_PROJECT_ID=proyecto-dummy
BIGQUERY_DATASET=agricultura_dataset
BIGQUERY_TABLA_AGRICULTURA=gold_cultivos_valle_geo

# Ruta a la llave de la service account. SOLO para desarrollo local.
# En Cloud Run / GKE se deja VACIA: la identidad la da la SA "pegada" al servicio.
GOOGLE_APPLICATION_CREDENTIALS=./agricultura-sa.json

# --- Cliente hacia la API ValleData (Flujo 2: ingesta de comentarios) ---
# true  -> comentarios de ejemplo, sin llamar a ValleData (desarrollo).
# false -> llama a la API ValleData real.
USAR_VALLEDATA_FALSO=true
VALLEDATA_API_BASE_URL=http://localhost:8001
VALLEDATA_API_TOKEN=cambia-esto-por-el-token-de-valledata
VALLEDATA_TIMEOUT_SEGUNDOS=30
