# Plantilla de configuracion de DataGov. Copia a .env y rellena tus valores.
#   cp .env.example .env
# El .env real NO se sube a git (esta en .gitignore).

# Token que esta API exige a quien la consume (ValleData y el DAG).
API_TOKEN=

# true = datos de ejemplo en memoria; false = consulta BigQuery real.
USAR_DATOS_FALSOS=
# Proyecto GCP donde viven las vistas y se ejecutan las consultas.
GCP_PROJECT_ID=

# Dataset de BigQuery con las vistas de comentarios.
BIGQUERY_DATASET_COMENTARIOS=
# Vista del detalle: un comentario por fila (con sentimiento y emocion).
BIGQUERY_VISTA_COMENTARIOS_DETALLE=
# Vista del resumen: totales y porcentajes por dataset.
BIGQUERY_VISTA_COMENTARIOS_RESUMEN_DATASET=

# Ruta a la llave .json de la service account. Vacio = usa tu cuenta (ADC) o la SA del servicio.
GOOGLE_APPLICATION_CREDENTIALS=

# true = comentarios de ejemplo; false = llama a la API ValleData real.
USAR_VALLEDATA_FALSO=
# URL base de la API ValleData.
VALLEDATA_API_BASE_URL=
# Token que ValleData exige (debe coincidir con el API_TOKEN de ValleData).
VALLEDATA_API_TOKEN=
# Timeout (segundos) de las llamadas a ValleData.
VALLEDATA_TIMEOUT_SEGUNDOS=
